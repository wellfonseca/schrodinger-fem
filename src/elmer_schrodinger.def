B64EOF
    gfortran -c SchrodingerSolver.F90 -o SchrodingerSolver.o \
        -DCONTIG= -DHAVE_EXECUTECOMMANDLINE -DUSE_ISO_C_BINDINGS \
        -O2 -fPIC -I$BLD/fmodules
    gfortran -shared SchrodingerSolver.o -o $SHARE/lib/SchrodingerSolver.so \
        -L/opt/elmer/lib/elmersolver -lelmersolver

    # Sanity only. Both lines guard a bug that already shipped once: a missing
    # .so (libfhuti) and a wrong module search path (ELMER_LIB).
    if ldd /opt/elmer/bin/ElmerSolver | grep -q 'not found'; then
        echo "ElmerSolver has missing shared libraries"; exit 1
    fi
    test -f $SHARE/lib/SchrodingerSolver.so || { echo "solver not installed"; exit 1; }

    cd /; rm -rf $HOME/elmerfem /var/lib/apt/lists/*

%runscript
    if [ $# -eq 0 ]; then exec /bin/bash; fi
    exec "$@"
