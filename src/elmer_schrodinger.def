Bootstrap: docker
From: debian:12

# Elmer FEM 9.0 + SchrodingerSolver.
#
#   build, no root:  unshare -r fakeroot apptainer build --force OUT.sif elmer_schrodinger.def
#   build, as root:  sudo apptainer build OUT.sif elmer_schrodinger.def
#   run:             apptainer exec OUT.sif ElmerSolver caso.sif
#                    apptainer exec OUT.sif gmsh caso.geo -2 -o caso.msh
#                    apptainer exec OUT.sif ElmerGrid 14 2 caso.msh -out mesh
#                    apptainer run  OUT.sif
#
# Solver: /opt/elmer/share/elmersolver/lib/SchrodingerSolver.so
# Self-contained: solver source embedded, compressed.
# Notes and troubleshooting: CONTAINER_LEIA-ME.md

%environment
    export LC_ALL=C
    export ELMER_HOME=/opt/elmer
    export ELMER_SOLVER_HOME=/opt/elmer/share/elmersolver
    # Must point at the MODULES. If set, Elmer searches only "." and $ELMER_LIB
    # (Load.c), never $ELMER_HOME/share/elmersolver/lib.
    export ELMER_LIB=/opt/elmer/share/elmersolver/lib
    export PATH=/opt/elmer/bin:$PATH
    export LD_LIBRARY_PATH=/opt/elmer/lib/elmersolver:$LD_LIBRARY_PATH
    export OMP_NUM_THREADS=1

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    # Rootless apt: (1) never drop to user _apt; (2) postinst scripts call
    # chown/chgrp by absolute path and fail under fakeroot, leaving
    # openssh-client unconfigured -> openmpi-bin unconfigured -> no mpicc.
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99nosandbox
    for b in /usr/bin/chown /bin/chown /usr/bin/chgrp /bin/chgrp; do
        [ -e "$b" ] || continue
        mv "$b" "$b.real"
        printf '#!/bin/sh\nexit 0\n' > "$b"
        chmod 0755 "$b"
    done

    apt-get update -qq
    apt-get install -y --no-install-recommends \
        ca-certificates build-essential gfortran g++ cmake make git wget \
        python3 gmsh openssh-client \
        libopenblas-dev liblapack-dev libopenmpi-dev openmpi-bin \
        libsuitesparse-dev libarpack2-dev lua5.3 liblua5.3-dev \
        zlib1g-dev libxml2-dev > /tmp/apt.log 2>&1 || true
    dpkg --configure -a > /dev/null 2>&1 || true

    for b in /usr/bin/chown /bin/chown /usr/bin/chgrp /bin/chgrp; do
        if [ -e "$b.real" ]; then mv -f "$b.real" "$b"; fi
    done

    # No MUMPS: Debian 12's libmumps-dev exports ParMETIS_V3_NodeND, so
    # FindMumps.cmake then demands ParMetis, which has no Debian 12 package.
    # UMFPACK covers the direct solves; the eigenproblem uses LAPACK DSYGV.
    cd $HOME
    git clone -q --depth=1 --branch release-9.0 \
        https://github.com/ElmerCSC/elmerfem.git
    cd elmerfem && mkdir build && cd build
    cmake -Wno-dev \
        -DCMAKE_INSTALL_PREFIX=/opt/elmer -DCMAKE_BUILD_TYPE=Release \
        -DWITH_MPI=TRUE -DWITH_OpenMP=FALSE -DWITH_Mumps=FALSE \
        -DWITH_LUA=TRUE -DWITH_MATC=TRUE -DEXTERNAL_UMFPACK=TRUE \
        -DWITH_ELMERGUI=FALSE -DWITH_QT5=FALSE -DBUILD_TESTING=FALSE \
        .. > /dev/null

    # Only the needed targets: the `all` target fails on DCRComplexSolve.F90
    # (Elmer 9.0 bug with gfortran >= 10) and that module is unused here.
    make -j$(nproc) elmersolver elmersolver_link \
         ResultOutputSolve Poisson StatElecSolve ElmerGrid Matc_bin > /dev/null

    # Manual install: `make install` triggers the failing `all` target.
    BLD=$HOME/elmerfem/build
    SHARE=/opt/elmer/share/elmersolver
    mkdir -p /opt/elmer/bin /opt/elmer/lib/elmersolver $SHARE/lib $SHARE/include

    find $BLD -name 'lib*.so' -type f | grep -vE 'metis-|libmpi_stubs' | \
        xargs -I{} cp -f {} /opt/elmer/lib/elmersolver/
    for b in ElmerSolver_mpi ElmerGrid matc; do
        f=$(find $BLD -name $b -type f -perm -u+x | head -1)
        test -n "$f" || { echo "missing binary: $b"; exit 1; }
        cp -f "$f" /opt/elmer/bin/
    done
    ln -sf ElmerSolver_mpi /opt/elmer/bin/ElmerSolver
    for s in ResultOutputSolve Poisson StatElecSolve; do
        cp -f $BLD/fem/src/modules/$s.so $SHARE/lib/
    done
    for f in elements.def SOLVER.KEYWORDS; do
        cp -f "$(find $BLD $HOME/elmerfem -name $f | head -1)" $SHARE/lib/
    done
    for d in lua-scripts license_texts; do
        cp -r "$(find $HOME/elmerfem -maxdepth 4 -type d -name $d | head -1)" $SHARE/
    done
    cp -f $BLD/fmodules/*.mod $SHARE/include/
    echo /opt/elmer/lib/elmersolver > /etc/ld.so.conf.d/elmer.conf
    ldconfig

    # SchrodingerSolver
    mkdir -p /opt/src && cd /opt/src
    # Solver source, compressed (gzip+base64). Readable copy in
    # solver/SchrodingerSolver.F90. Regenerate: python3 gera_def.py
    base64 -d <<'B64EOF' | zcat > SchrodingerSolver.F90
